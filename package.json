{
  "name": "landonorris-rebuild",
  "version": "1.0.0",
  "private": true,
  "description": "Functional rebuild of landonorris.com: server-rendered pages, CMS data export, interactions and business rules.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build": "node scripts/build-static.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "extract": "python -I scripts/extract-cms.py scripts/source-snapshot data",
    "mirror": "node scripts/mirror-assets.mjs",
    "mirror:original": "node scripts/mirror-original.mjs",
    "refresh:original": "node scripts/mirror-original.mjs --refresh",
    "start:rebuild": "node server.mjs --rebuild"
  },
  "dependencies": {
    "@rive-app/canvas-lite": "2.26.4",
    "gsap": "3.13.0",
    "lenis": "1.1.13",
    "three": "0.174.0"
  }
}
